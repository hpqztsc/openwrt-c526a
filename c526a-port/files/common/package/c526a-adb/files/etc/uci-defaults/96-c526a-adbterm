#!/bin/sh
#
# Add the interactive ADB terminal (ttyd on 7682) once.
#
if ! uci -q get ttyd.adbterm >/dev/null 2>&1; then
	uci set ttyd.adbterm=ttyd
	uci set ttyd.adbterm.enable='1'
	uci set ttyd.adbterm.port='7682'
	uci set ttyd.adbterm.interface='@lan'
	uci set ttyd.adbterm.command='/usr/bin/adb-term'
	uci set ttyd.adbterm.max_clients='2'
	uci set ttyd.adbterm.url_arg='1'
	pass=$(head -c 32 /dev/urandom | md5sum | cut -c1-12)
	uci set ttyd.adbterm.credential="adb:$pass"
	uci commit ttyd
	echo "$pass" > /root/adb-term-password
	chmod 600 /root/adb-term-password
fi

grep -qx /root/adb-term-password /etc/sysupgrade.conf 2>/dev/null ||
	echo /root/adb-term-password >> /etc/sysupgrade.conf

[ -x /etc/init.d/ttyd ] && {
	/etc/init.d/ttyd enable
	/etc/init.d/ttyd restart
}

exit 0

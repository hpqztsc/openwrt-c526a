#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	local enabled

	config_load adb
	config_get_bool enabled sms enabled 1
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/adb-sms
	procd_set_param env HOME=/root
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger adb
}

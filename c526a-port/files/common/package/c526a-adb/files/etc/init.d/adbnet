#!/bin/sh /etc/rc.common

START=91
USE_PROCD=1

start_service() {
	local enabled reconnect

	config_load adb
	config_get_bool enabled main enabled 1
	config_get_bool reconnect main reconnect 1
	[ "$enabled" = 1 ] && [ "$reconnect" = 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/adb-net
	procd_set_param env HOME=/root
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger adb
}

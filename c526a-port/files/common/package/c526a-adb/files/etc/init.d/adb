#!/bin/sh /etc/rc.common

START=90
USE_PROCD=1

start_service() {
	local enabled listen_lan connect

	config_load adb
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get_bool listen_lan main listen_lan 0
	config_get connect main connect ""

	procd_open_instance
	if [ "$listen_lan" = 1 ]; then
		procd_set_param command /usr/bin/adb -a nodaemon server
	else
		# the in-tree adb (1.0.32) only knows the default localhost:5037
		procd_set_param command /usr/bin/adb nodaemon server
	fi
	procd_set_param env HOME=/root
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	for h in $connect; do
		( sleep 5; /usr/bin/adb connect "$h" ) &
	done
}

service_triggers() {
	procd_add_reload_trigger adb
}

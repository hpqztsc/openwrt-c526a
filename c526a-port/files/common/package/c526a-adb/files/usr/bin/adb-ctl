#!/bin/sh
#
# Small adb helper for the router console.
#
cmd="$1"
shift 2>/dev/null

case "$cmd" in
	devices)
		exec adb devices -l
		;;
	connect|net)
		exec adb connect "$@"
		;;
	disconnect)
		exec adb disconnect "$@"
		;;
	tcpip)
		exec adb tcpip "${1:-5555}"
		;;
	pair)
		echo "adb 1.0.32 has no 'adb pair' (Android 11+ wireless debugging)."
		echo "USB once:  adb-ctl tcpip 5555   then  adb-ctl connect <phone-ip>:5555"
		echo "rooted:    adb-ctl enable-tcp [port]"
		;;
	enable-tcp)
		port="${1:-5555}"
		adb shell su <<EOF
setprop service.adb.tcp.port $port
setprop persist.adb.tcp.port $port
stop adbd
start adbd
EOF
		echo "adbd now listens on $port (persist.adb.tcp.port is set)"
		;;
	token)
		if [ -n "$1" ]; then
			uci set adb.sms.api_token="$1"
			uci commit adb
			echo "token set"
		else
			uci -q get adb.sms.api_token
		fi
		;;
	shell)
		exec adb shell "$@"
		;;
	root)
		exec adb root
		;;
	sms)
		adb shell su <<'EOF'
content query --uri content://sms/inbox --projection _id,address,date,body --sort "date DESC"
EOF
		;;
	shot)
		out="${1:-/tmp/screen.png}"
		if adb exec-out screencap -p > "$out" 2>/dev/null && [ -s "$out" ]; then
			echo "$out"
		else
			adb shell screencap -p /data/local/tmp/_adb_shot.png &&
			adb pull /data/local/tmp/_adb_shot.png "$out" >/dev/null &&
			adb shell rm -f /data/local/tmp/_adb_shot.png &&
			echo "$out"
		fi
		;;
	tap)
		adb shell input tap "$1" "$2"
		;;
	swipe)
		adb shell input swipe "$1" "$2" "$3" "$4"
		;;
	text)
		adb shell input text "$1"
		;;
	key)
		adb shell input keyevent "$1"
		;;
	ui)
		if ! adb exec-out uiautomator dump /dev/tty 2>/dev/null; then
			adb shell uiautomator dump /data/local/tmp/_adb_ui.xml >/dev/null &&
			adb shell cat /data/local/tmp/_adb_ui.xml &&
			adb shell rm -f /data/local/tmp/_adb_ui.xml
		fi
		;;
	install)
		adb install -r "$1"
		;;
	*)
		cat <<EOF
usage: adb-ctl <command>
  devices                     list connected devices
  connect <ip:port>           network adb (alias: net)
  disconnect [ip:port]
  tcpip [port]                put a USB-connected phone into TCP mode (default 5555)
  enable-tcp [port]           same, for a rooted phone without USB (persists)
  pair                        explain the Android 11+ pairing limitation
  token [new]                 show or set the web UI API token
  shell <cmd>                 run a shell command on the device
  root                        restart adbd as root (userdebug/rooted)
  sms                         dump the SMS inbox (root required)
  shot [file]                 screenshot (default /tmp/screen.png)
  tap <x> <y>
  swipe <x1> <y1> <x2> <y2>
  text <string>
  key <keycode>
  ui                          dump the current UI hierarchy
  install <apk>
EOF
		;;
esac

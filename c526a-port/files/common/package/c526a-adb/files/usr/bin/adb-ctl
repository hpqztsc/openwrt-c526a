#!/bin/sh
#
# Small adb helper for the router console.
#
SERIAL=${ADB_SERIAL:-}
while [ $# -gt 0 ]; do
	case "$1" in
	-s|--serial)
		SERIAL=$2
		shift 2
		;;
	*) break ;;
	esac
done

adb_cmd() {
	if [ -n "$SERIAL" ]; then
		adb -s "$SERIAL" "$@"
	else
		adb "$@"
	fi
}

cmd="$1"
shift 2>/dev/null

case "$cmd" in
	devices)
		exec adb devices -l
		;;
	connect|net)
		exec adb connect "$@"
		;;
	disconnect)
		exec adb disconnect "$@"
		;;
	tcpip)
		adb_cmd tcpip "${1:-5555}"
		exit $?
		;;
	pair)
		echo "adb 1.0.32 has no 'adb pair' (Android 11+ wireless debugging)."
		echo "USB once:  adb-ctl tcpip 5555   then  adb-ctl connect <phone-ip>:5555"
		echo "rooted:    adb-ctl enable-tcp [port]"
		;;
	enable-tcp)
		port="${1:-5555}"
		adb_cmd shell su <<EOF
setprop service.adb.tcp.port $port
setprop persist.adb.tcp.port $port
stop adbd
start adbd
EOF
		echo "adbd now listens on $port (persist.adb.tcp.port is set)"
		;;
	token)
		if [ -n "$1" ]; then
			uci set adb.sms.api_token="$1"
			uci commit adb
			echo "token set"
		else
			uci -q get adb.sms.api_token
		fi
		;;
	shell)
		adb_cmd shell "$@"
		exit $?
		;;
	root)
		adb_cmd root
		exit $?
		;;
	sms)
		query='content query --uri content://sms/inbox --projection _id,address,date,body --sort "date DESC"'
		out=$(adb_cmd shell "$query" 2>&1)
		case "$out" in
		*"Error while accessing provider"*|*"Permission Denial"*|*"SecurityException"*)
			out=$(adb_cmd shell "su -c '$query'" 2>/dev/null)
			;;
		esac
		printf '%s\n' "$out"
		;;
	shot)
		out="${1:-/tmp/screen.png}"
		# adb 1.0.32's exec-out mixes screencap's display warning into the PNG.
		adb_cmd shell screencap -p /data/local/tmp/_adb_shot.png >/dev/null 2>&1 &&
		adb_cmd pull /data/local/tmp/_adb_shot.png "$out" >/dev/null &&
		adb_cmd shell rm -f /data/local/tmp/_adb_shot.png &&
		echo "$out"
		;;
	tap)
		adb_cmd shell input tap "$1" "$2"
		;;
	swipe)
		adb_cmd shell input swipe "$1" "$2" "$3" "$4"
		;;
	text)
		adb_cmd shell input text "$1"
		;;
	key)
		adb_cmd shell input keyevent "$1"
		;;
	ui)
		if ! adb_cmd exec-out uiautomator dump /dev/tty 2>/dev/null; then
			adb_cmd shell uiautomator dump /data/local/tmp/_adb_ui.xml >/dev/null &&
			adb_cmd shell cat /data/local/tmp/_adb_ui.xml &&
			adb_cmd shell rm -f /data/local/tmp/_adb_ui.xml
		fi
		;;
	install)
		adb_cmd install -r "$1"
		;;
	*)
		cat <<EOF
usage: adb-ctl [-s <serial>] <command>
  -s <serial>                 target a device (or set ADB_SERIAL)
  devices                     list connected devices
  connect <ip:port>           network adb (alias: net)
  disconnect [ip:port]
  tcpip [port]                put a USB-connected phone into TCP mode (default 5555)
  enable-tcp [port]           same, for a rooted phone without USB (persists)
  pair                        explain the Android 11+ pairing limitation
  token [new]                 show or set the web UI API token
  shell <cmd>                 run a shell command on the device
  root                        restart adbd as root (userdebug/rooted)
  sms                         dump the SMS inbox (root only as a fallback)
  shot [file]                 screenshot (default /tmp/screen.png)
  tap <x> <y>
  swipe <x1> <y1> <x2> <y2>
  text <string>
  key <keycode>
  ui                          dump the current UI hierarchy
  install <apk>
EOF
		;;
esac

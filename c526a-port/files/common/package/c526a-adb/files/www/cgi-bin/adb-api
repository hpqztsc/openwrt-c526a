#!/bin/sh
#
# JSON API for the ADB web UI (/adb/).
#
# Every device action accepts a "device=<serial>" parameter.  With exactly
# one authorized device it may be omitted; with multiple devices the caller
# must choose one, otherwise a "multiple devices" error is returned.
#
. /usr/share/libubox/jshn.sh
. /usr/lib/c526a-adb.sh

get_param() {
	local key="$1" pair
	for pair in $(printf '%s' "${QUERY_STRING:-}" | tr '&' ' '); do
		case "$pair" in
		"$key="*) urldecode "${pair#*=}"; return 0 ;;
		esac
	done
	return 1
}

json_error() {
	json_init
	json_add_string error "$1"
}

add_devices_array() {
	local line serial state model product devname transport tok

	json_add_array devices
	adb devices -l 2>/dev/null | sed -n '2,$p' > "/tmp/.adbdev.$$"
	while read -r line; do
		[ -n "$line" ] || continue
		set -- $line
		serial=$1
		state=$2
		[ "$state" = "no" ] && state="no permissions"
		model=""; product=""; devname=""; transport=""
		shift 2
		for tok in "$@"; do
			case "$tok" in
			model:*) model=${tok#model:} ;;
			product:*) product=${tok#product:} ;;
			device:*) devname=${tok#device:} ;;
			usb:*) transport="usb" ;;
			tcp:*) transport="tcp" ;;
			esac
		done
		json_add_object
		json_add_string serial "$serial"
		json_add_string id "$serial"
		json_add_string state "$state"
		json_add_string model "$model"
		json_add_string product "$product"
		json_add_string device "$devname"
		json_add_string transport "$transport"
		json_close_object
	done < "/tmp/.adbdev.$$"
	rm -f "/tmp/.adbdev.$$"
	json_close_array
}

# Resolve the target device into $DEV.  Prints a JSON error and returns 1
# when the request is ambiguous or the device is not authorized.
resolve_device() {
	local req st n

	req=$(get_param device)
	adb_serials > "/tmp/.adbok.$$"

	if [ -n "$req" ]; then
		if grep -Fxq "$req" "/tmp/.adbok.$$"; then
			DEV=$req
			rm -f "/tmp/.adbok.$$"
			return 0
		fi
		st=$(adb devices 2>/dev/null | awk -v s="$req" '$1 == s { print $2; exit }')
		rm -f "/tmp/.adbok.$$"
		json_error "device ${req} is ${st:-not connected}"
		return 1
	fi

	n=$(wc -l < "/tmp/.adbok.$$")
	if [ "$n" -eq 1 ]; then
		DEV=$(cat "/tmp/.adbok.$$")
		rm -f "/tmp/.adbok.$$"
		return 0
	fi
	rm -f "/tmp/.adbok.$$"
	if [ "$n" -eq 0 ]; then
		json_error "no authorized device"
	else
		json_error "multiple devices; select one"
	fi
	return 1
}

# Run a content query as the shell UID, falling back to su only when the
# provider denies it.  The shared implementation also strips CR from output.
prop() {
	adb_timeout 10 adb -s "$DEV" shell getprop "$1" 2>/dev/null | tr -d '\r'
}

valid_sdcard_path() {
	case "$1" in
	/sdcard|/sdcard/*) ;;
	*) return 1 ;;
	esac
	case "$1" in
	*..*|*"'"*) return 1 ;;
	esac
	return 0
}

token=$(uci -q get adb.sms.api_token)
req="${HTTP_X_TOKEN:-}"
[ -n "$req" ] || req=$(get_param token)
if [ -n "$token" ] && [ "$req" != "$token" ]; then
	printf 'Status: 403 Forbidden\r\nContent-Type: application/json\r\n\r\n'
	echo '{"error":"unauthorized"}'
	exit 0
fi

action=$(get_param action)
[ -n "$action" ] || action=status

# Screenshot must resolve the device before sending image headers.
if [ "$action" = "screenshot" ]; then
	if ! resolve_device; then
		printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
		json_dump
		exit 0
	fi
	shot_local="/tmp/_adb_web.$$.png"
	shot_remote="/data/local/tmp/_adb_web.$$.png"
	rm -f "$shot_local"
	# adb 1.0.32's exec-out lets screencap's "multiple displays" warning into
	# the PNG stream, so always capture to a file and pull it.
	adb_timeout 20 adb -s "$DEV" shell screencap -p "$shot_remote" >/dev/null 2>&1
	adb_timeout 20 adb -s "$DEV" pull "$shot_remote" "$shot_local" >/dev/null 2>&1
	adb_timeout 10 adb -s "$DEV" shell rm -f "$shot_remote" >/dev/null 2>&1
	magic=""
	[ -s "$shot_local" ] && magic=$(head -c 8 "$shot_local" | hexdump -v -e '1/1 "%02x"')
	if [ "$magic" = "89504e470d0a1a0a" ]; then
		printf 'Content-Type: image/png\r\nCache-Control: no-store\r\n\r\n'
		cat "$shot_local"
	else
		printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
		echo '{"error":"screenshot failed"}'
	fi
	rm -f "$shot_local"
	exit 0
fi

# File download must resolve the device before sending binary headers.
if [ "$action" = "download" ]; then
	p=$(get_param path)
	if ! valid_sdcard_path "$p"; then
		printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
		echo '{"error":"path must be under /sdcard"}'
		exit 0
	fi
	if ! resolve_device; then
		printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
		json_dump
		exit 0
	fi
	ok=$(adb_timeout 10 adb -s "$DEV" shell "[ -f '$p' ] && echo yes" 2>/dev/null)
	if [ "$ok" != "yes" ]; then
		printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
		echo '{"error":"not a regular file"}'
		exit 0
	fi
	# Resolve symlinks on the phone; a link inside /sdcard must not escape it.
	real=$(adb_timeout 10 adb -s "$DEV" shell "readlink -f '$p' 2>/dev/null" 2>/dev/null | tr -d '\r')
	root=$(adb_timeout 10 adb -s "$DEV" shell "readlink -f /sdcard 2>/dev/null" 2>/dev/null | tr -d '\r')
	[ -n "$root" ] || root=/sdcard
	if [ -n "$real" ]; then
		case "$real" in
		"$root"|"$root"/*) ;;
		*)
			printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
			echo '{"error":"path escapes /sdcard"}'
			exit 0
			;;
		esac
	else
		link=$(adb_timeout 10 adb -s "$DEV" shell "[ -L '$p' ] && echo yes" 2>/dev/null)
		if [ "$link" = "yes" ]; then
			printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
			echo '{"error":"symlink download refused"}'
			exit 0
		fi
	fi
	printf 'Content-Type: application/octet-stream\r\n'
	printf 'Content-Disposition: attachment; filename="download"\r\n'
	printf 'Cache-Control: no-store\r\n\r\n'
	# Stream instead of pulling to /tmp: recordings and videos can be large,
	# and /tmp is RAM-backed on OpenWrt.  exec-out is binary clean for cat.
	# The remote path is single-quoted; valid_sdcard_path rejects "'".
	adb -s "$DEV" exec-out cat "'$p'" 2>/dev/null
	exit 0
fi

printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'

case "$action" in
status)
	json_init
	json_add_string server "$(pgrep -f 'adb.*server' >/dev/null 2>&1 && echo running || echo stopped)"
	json_add_int auth "$([ -n "$token" ] && echo 1 || echo 0)"
	add_devices_array
	default=$(adb_serials)
	[ "$(printf '%s\n' "$default" | grep -c .)" -eq 1 ] && json_add_string default "$default"
	json_dump
	;;
devices)
	json_init
	add_devices_array
	json_dump
	;;
connect)
	h=$(get_param host)
	json_init
	if [ -n "$h" ]; then
		json_add_string output "$(adb connect "$h" 2>&1)"
	else
		json_add_string error "host required"
	fi
	json_dump
	;;
disconnect)
	h=$(get_param host)
	json_init
	json_add_string output "$(adb disconnect "$h" 2>&1)"
	json_dump
	;;
sms)
	resolve_device || { json_dump; exit 0; }
	safe=$(safe_serial "$DEV")
	mkdir -p /tmp/adb-sms
	[ -s "/tmp/adb-sms/$safe.json" ] || /usr/bin/adb-sms --once "$DEV" >/dev/null 2>&1
	if [ -s "/tmp/adb-sms/$safe.json" ]; then
		cat "/tmp/adb-sms/$safe.json"
	else
		json_init; json_add_string device "$DEV"; json_add_array messages; json_close_array; json_dump
	fi
	;;
poll)
	resolve_device || { json_dump; exit 0; }
	/usr/bin/adb-sms --once "$DEV" >/dev/null 2>&1
	safe=$(safe_serial "$DEV")
	if [ -s "/tmp/adb-sms/$safe.json" ]; then
		cat "/tmp/adb-sms/$safe.json"
	else
		json_init; json_add_string device "$DEV"; json_add_array messages; json_close_array; json_dump
	fi
	;;
contacts)
	resolve_device || { json_dump; exit 0; }
	tsv="/tmp/.adb-rows.$$"
	content_query content://contacts/phones _id:number:display_name "display_name ASC" |
	sed -n 's/^Row: [0-9][0-9]* //p' |
	awk -F', ' '{
		id=$1; sub(/^_id=/, "", id)
		num=$2; sub(/^number=/, "", num)
		name=$3; sub(/^display_name=/, "", name)
		for (i=4; i<=NF; i++) name=name ", " $i
		if (name == "NULL") name=""
		if (num == "NULL") num=""
		if (name == "") name=num
		gsub(/\t/, " ", name); gsub(/\t/, " ", num)
		if (id != "") printf "%s\t%s\t%s\n", id, num, name
	}' > "$tsv"
	json_init
	json_add_int count "$(wc -l < "$tsv" | tr -d ' ')"
	json_add_array contacts
	while IFS="$(printf '\t')" read -r id num name; do
		json_add_object
		json_add_string id "$id"
		json_add_string number "$num"
		json_add_string name "$name"
		json_close_object
	done < "$tsv"
	json_close_array
	rm -f "$tsv"
	json_dump
	;;
calls)
	resolve_device || { json_dump; exit 0; }
	tsv="/tmp/.adb-rows.$$"
	content_query content://call_log/calls _id:number:date:duration:type:geocoded_location:name "date DESC" |
	sed -n 's/^Row: [0-9][0-9]* //p' |
	awk -F', ' '{
		id=$1; sub(/^_id=/, "", id)
		num=$2; sub(/^number=/, "", num)
		date=$3; sub(/^date=/, "", date)
		dur=$4; sub(/^duration=/, "", dur)
		type=$5; sub(/^type=/, "", type)
		loc=$6; sub(/^geocoded_location=/, "", loc)
		name=$7; sub(/^name=/, "", name)
		for (i=8; i<=NF; i++) name=name ", " $i
		if (name == "NULL") name=""
		if (loc == "NULL") loc=""
		gsub(/\t/, " ", name); gsub(/\t/, " ", loc)
		if (id != "") printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n", id, num, date, dur, type, loc, name
	}' | head -n 100 > "$tsv"
	json_init
	json_add_int count "$(wc -l < "$tsv" | tr -d ' ')"
	json_add_array calls
	while IFS="$(printf '\t')" read -r id num date dur type loc name; do
		json_add_object
		json_add_string id "$id"
		json_add_string number "$num"
		json_add_string date "$date"
		json_add_string duration "$dur"
		json_add_string type "$type"
		json_add_string location "$loc"
		json_add_string name "$name"
		json_close_object
	done < "$tsv"
	json_close_array
	rm -f "$tsv"
	json_dump
	;;
threads)
	resolve_device || { json_dump; exit 0; }
	tsv="/tmp/.adb-rows.$$"
	content_query content://mms-sms/conversations _id:address:date:type:read:body "date DESC" |
	sed -n 's/^Row: [0-9][0-9]* //p' |
	awk -F', ' '{
		id=$1; sub(/^_id=/, "", id)
		addr=$2; sub(/^address=/, "", addr)
		date=$3; sub(/^date=/, "", date)
		type=$4; sub(/^type=/, "", type)
		read=$5; sub(/^read=/, "", read)
		body=$6; sub(/^body=/, "", body)
		for (i=7; i<=NF; i++) body=body ", " $i
		if (body == "NULL") body=""
		gsub(/\t/, " ", body)
		if (id != "") printf "%s\t%s\t%s\t%s\t%s\t%s\n", id, addr, date, type, read, body
	}' | head -n 100 > "$tsv"
	json_init
	json_add_int count "$(wc -l < "$tsv" | tr -d ' ')"
	json_add_array threads
	while IFS="$(printf '\t')" read -r id addr date type read body; do
		json_add_object
		json_add_string id "$id"
		json_add_string address "$addr"
		json_add_string date "$date"
		json_add_string type "$type"
		json_add_string read "$read"
		json_add_string body "$body"
		json_close_object
	done < "$tsv"
	json_close_array
	rm -f "$tsv"
	json_dump
	;;
notifications)
	resolve_device || { json_dump; exit 0; }
	tsv="/tmp/.adb-rows.$$"
	adb_timeout 20 adb -s "$DEV" shell "dumpsys notification --noredact" 2>/dev/null |
	awk '
	/NotificationRecord\(/ { pkg=""; title=""; text=""; if (match($0, /pkg=[^ ]+/)) pkg=substr($0, RSTART+4, RLENGTH-4); next }
	/android\.title=/ {
		line=$0; sub(/^[ \t]*android\.title=[^ ]+ \(/, "", line); sub(/\)[ \t]*$/, "", line)
		gsub(/\t/, " ", line); title=line; next
	}
	/android\.text=/ {
		line=$0; sub(/^[ \t]*android\.text=[^ ]+ \(/, "", line); sub(/\)[ \t]*$/, "", line)
		gsub(/\t/, " ", line); text=line
		if (title != "" || text != "") {
			key=pkg SUBSEP title SUBSEP text
			if (!seen[key]++) printf "%s\t%s\t%s\n", pkg, title, text
			title=""
		}
	}' | head -n 50 > "$tsv"
	json_init
	json_add_int count "$(wc -l < "$tsv" | tr -d ' ')"
	json_add_array notifications
	while IFS="$(printf '\t')" read -r pkg title text; do
		json_add_object
		json_add_string package "$pkg"
		json_add_string title "$title"
		json_add_string text "$text"
		json_close_object
	done < "$tsv"
	json_close_array
	rm -f "$tsv"
	json_dump
	;;
files)
	p=$(get_param path)
	[ -n "$p" ] || p=/sdcard
	if ! valid_sdcard_path "$p"; then
		json_error "path must be under /sdcard"
		json_dump
		exit 0
	fi
	resolve_device || { json_dump; exit 0; }
	tsv="/tmp/.adb-rows.$$"
	adb_timeout 20 adb -s "$DEV" shell "ls -1Ap '$p'" 2>/dev/null | tr -d '\r' > "$tsv"
	json_init
	json_add_string path "$p"
	json_add_array entries
	while IFS= read -r name; do
		[ -n "$name" ] || continue
		case "$name" in
		*/) dir=1; name=${name%/} ;;
		*) dir=0 ;;
		esac
		json_add_object
		json_add_string name "$name"
		json_add_int dir "$dir"
		json_close_object
	done < "$tsv"
	json_close_array
	rm -f "$tsv"
	json_dump
	;;
system)
	resolve_device || { json_dump; exit 0; }
	bat=$(adb_timeout 10 adb -s "$DEV" shell "dumpsys battery" 2>/dev/null)
	tel=$(adb_timeout 10 adb -s "$DEV" shell "dumpsys telephony.registry" 2>/dev/null)
	dfout=$(adb_timeout 10 adb -s "$DEV" shell "df -k /sdcard" 2>/dev/null | tail -n 1)
	uptime=$(adb_timeout 10 adb -s "$DEV" shell "cat /proc/uptime" 2>/dev/null | awk '{ print int($1) }')
	sig=$(printf '%s\n' "$tel" | grep -m 1 'mSignalStrength=' | sed -n 's/.*[^A-Za-z]level[[:space:]]*=[[:space:]]*\([0-9]*\).*/\1/p')
	op=$(prop gsm.sim.operator.alpha)
	[ -n "$op" ] || op=$(prop gsm.operator.alpha)
	json_init
	json_add_string model "$(prop ro.product.model)"
	json_add_string manufacturer "$(prop ro.product.manufacturer)"
	json_add_string android "$(prop ro.build.version.release)"
	json_add_string sdk "$(prop ro.build.version.sdk)"
	json_add_string hostname "$(prop net.hostname)"
	json_add_string timezone "$(prop persist.sys.timezone)"
	json_add_string operator "$op"
	json_add_string signal_level "$sig"
	json_add_string battery_level "$(printf '%s\n' "$bat" | sed -n 's/^[[:space:]]*level: //p' | head -n 1)"
	json_add_string battery_status "$(printf '%s\n' "$bat" | sed -n 's/^[[:space:]]*status: //p' | head -n 1)"
	json_add_string battery_temp "$(printf '%s\n' "$bat" | sed -n 's/^[[:space:]]*temperature: //p' | head -n 1)"
	json_add_string battery_voltage "$(printf '%s\n' "$bat" | sed -n 's/^[[:space:]]*voltage: //p' | head -n 1)"
	json_add_string storage_total "$(printf '%s\n' "$dfout" | awk '{ print $2 }')"
	json_add_string storage_used "$(printf '%s\n' "$dfout" | awk '{ print $3 }')"
	json_add_string storage_avail "$(printf '%s\n' "$dfout" | awk '{ print $4 }')"
	json_add_string uptime "$uptime"
	json_dump
	;;
apps)
	resolve_device || { json_dump; exit 0; }
	tsv="/tmp/.adb-rows.$$"
	adb_timeout 20 adb -s "$DEV" shell "pm list packages -3" 2>/dev/null |
	sed -n 's/^package://p' | sort > "$tsv"
	total=$(adb_timeout 20 adb -s "$DEV" shell "pm list packages" 2>/dev/null | wc -l | tr -d ' ')
	json_init
	json_add_int count "$(wc -l < "$tsv" | tr -d ' ')"
	json_add_int total "$total"
	json_add_array apps
	while IFS= read -r pkg; do
		[ -n "$pkg" ] || continue
		json_add_object
		json_add_string package "$pkg"
		json_close_object
	done < "$tsv"
	json_close_array
	rm -f "$tsv"
	json_dump
	;;
record)
	resolve_device || { json_dump; exit 0; }
	secs=$(get_param seconds)
	case "$secs" in ''|*[!0-9]*) secs=10 ;; esac
	[ "$secs" -lt 3 ] && secs=3
	[ "$secs" -gt 30 ] && secs=30
	path="/sdcard/adb-record-$(date +%s).mp4"
	# screenrecord fails with INVALID_LAYER_STACK while the panel is dozing.
	adb_timeout 10 adb -s "$DEV" shell input keyevent 224 >/dev/null 2>&1
	sleep 1
	adb_timeout $((secs + 15)) adb -s "$DEV" shell "screenrecord --time-limit $secs '$path'" >/dev/null 2>&1
	size=$(adb_timeout 10 adb -s "$DEV" shell "stat -c %s '$path'" 2>/dev/null | tr -dc '0-9')
	json_init
	if [ -n "$size" ] && [ "$size" -gt 0 ] 2>/dev/null; then
		json_add_string path "$path"
		json_add_int seconds "$secs"
		json_add_int size "$size"
		json_add_string result ok
	else
		adb_timeout 10 adb -s "$DEV" shell "rm -f '$path'" >/dev/null 2>&1
		json_add_string error "screenrecord failed; check the screen state"
	fi
	json_dump
	;;
shell)
	cmd=$(get_param cmd)
	resolve_device || { json_dump; exit 0; }
	json_init
	if [ -n "$cmd" ]; then
		out=$(adb_timeout 20 adb -s "$DEV" shell "$cmd" 2>&1)
		json_add_string output "$out"
	else
		json_add_string error "cmd required"
	fi
	json_dump
	;;
input)
	t=$(get_param type)
	resolve_device || { json_dump; exit 0; }
	case "$t" in
	tap)
		adb_timeout 10 adb -s "$DEV" shell input tap "$(get_param x)" "$(get_param y)" >/dev/null 2>&1
		;;
	swipe)
		adb_timeout 10 adb -s "$DEV" shell input swipe "$(get_param x)" "$(get_param y)" \
			"$(get_param x2)" "$(get_param y2)" >/dev/null 2>&1
		;;
	text)
		adb_timeout 10 adb -s "$DEV" shell input text "$(get_param text)" >/dev/null 2>&1
		;;
	key)
		adb_timeout 10 adb -s "$DEV" shell input keyevent "$(get_param key)" >/dev/null 2>&1
		;;
	esac
	json_init
	json_add_string result ok
	json_dump
	;;
*)
	json_error "unknown action"
	json_dump
	;;
esac

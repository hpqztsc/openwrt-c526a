#!/bin/sh
#
# GET /cgi-bin/adb-sms[?token=...][&device=<serial>] -> the last N SMS as JSON
#
echo "Content-Type: application/json"
echo

. /usr/share/libubox/jshn.sh
. /usr/lib/c526a-adb.sh

token=$(uci -q get adb.sms.api_token)

if [ -n "$token" ]; then
	case "&${QUERY_STRING:-}&" in
	*"&token=$token&"*)
		;;
	*)
		echo '{"error":"unauthorized"}'
		exit 0
		;;
	esac
fi

device=$(printf '%s' "${QUERY_STRING:-}" | tr '&' '\n' | sed -n 's/^device=//p' | head -n 1)
[ -n "$device" ] && device=$(urldecode "$device")
[ -n "$device" ] || device=$(uci -q get adb.sms.serial)

if [ -n "$device" ]; then
	safe=$(safe_serial "$device")
	if [ -s "/tmp/adb-sms/$safe.json" ]; then
		cat "/tmp/adb-sms/$safe.json"
	else
		json_init
		json_add_string device "$device"
		json_add_array messages
		json_close_array
		json_dump
	fi
	exit 0
fi

# No device selected: keep the old single-device behaviour, but refuse to
# guess when more than one device has an inbox.
n=0
one=""
for f in /tmp/adb-sms/*.json; do
	[ -f "$f" ] || continue
	n=$((n + 1))
	one=$f
done

if [ "$n" -eq 1 ]; then
	cat "$one"
elif [ "$n" -eq 0 ]; then
	echo '{"messages":[]}'
else
	echo '{"error":"multiple devices; specify device"}'
fi

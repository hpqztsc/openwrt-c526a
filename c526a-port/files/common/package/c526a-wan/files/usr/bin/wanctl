#!/bin/sh
#
# wanctl - configure the four C526A uplinks and mwan3 policies.
#
#   wan      Ethernet WAN port (DHCP / PPPoE / static)
#   wan2     "specified gateway": macvlan on the LAN bridge (mode=lan) or a
#            dedicated LAN port (mode=port), static or DHCP
#   wwan     WiFi STA, normally managed by travelmate
#   usbwan   USB tethering / QMI / MBIM / NCM
#
# Uplinks are described in /etc/config/wanctl; "wanctl apply" materialises
# them into /etc/config/network, /etc/config/firewall and /etc/config/mwan3.
#
[ -f /lib/functions.sh ] && . /lib/functions.sh

WANCTL=wanctl
MW=mwan3
DRY=0

log() { logger -t wanctl -- "$*"; }

u_set() {
	[ "$DRY" = 1 ] && { echo "uci set $1=$2"; return 0; }
	uci set "$1=$2"
}
u_del() {
	[ "$DRY" = 1 ] && { echo "uci delete $1"; return 0; }
	uci -q delete "$1"
}
u_add_list() {
	[ "$DRY" = 1 ] && { echo "uci add_list $1=$2"; return 0; }
	uci add_list "$1=$2"
}
u_del_list() {
	[ "$DRY" = 1 ] && { echo "uci del_list $1=$2"; return 0; }
	uci -q del_list "$1=$2"
}
u_commit() {
	[ "$DRY" = 1 ] && { echo "uci commit $1"; return 0; }
	uci commit "$1"
}
cget() { uci -q get "$WANCTL.$1"; }

uplinks() {
	uci -q show "$WANCTL" 2>/dev/null | sed -n "s/^$WANCTL\.\([^.=]*\)=uplink$/\1/p"
}

ordered_uplinks() {
	local order name
	order=$(cget globals.order)
	for name in $order; do
		[ -n "$(cget "$name")" ] || continue
		printf '%s\n' "$name"
	done
	for name in $(uplinks); do
		case " $order " in
		*" $name "*) ;;
		*) printf '%s\n' "$name" ;;
		esac
	done
}

zone_wan() {
	local s
	for s in $(uci -q show firewall 2>/dev/null | sed -n 's/^firewall\.\([^.=]*\)=zone$/\1/p'); do
		[ "$(uci -q get "firewall.$s.name")" = wan ] && { echo "$s"; return 0; }
	done
	return 1
}

brlan_section() {
	local s
	for s in $(uci -q show network 2>/dev/null | sed -n 's/^network\.\([^.=]*\)=device$/\1/p'); do
		[ "$(uci -q get "network.$s.name")" = br-lan ] && { echo "$s"; return 0; }
	done
	return 1
}

link_opts() {
	local name=$1 iface=$2 defmetric=$3 metric peerdns dns

	metric=$(cget "$name.metric")
	[ -n "$metric" ] || metric=$defmetric
	u_set "network.$iface.metric" "$metric"

	peerdns=$(cget "$name.peerdns")
	[ -n "$peerdns" ] || peerdns=0
	u_set "network.$iface.peerdns" "$peerdns"

	dns=$(cget "$name.dns")
	[ -n "$dns" ] && u_set "network.$iface.dns" "$dns"
}

ensure_wan2() {
	local mode port proto ipaddr netmask gateway br mac p in_br

	mode=$(cget wan2.mode)
	port=$(cget wan2.port)
	[ -n "$port" ] || port=lan3
	proto=$(cget wan2.proto)
	[ -n "$proto" ] || proto=static
	ipaddr=$(cget wan2.ipaddr)
	netmask=$(cget wan2.netmask)
	gateway=$(cget wan2.gateway)

	if [ "$mode" = "port" ]; then
		br=$(brlan_section)
		[ -n "$br" ] && u_del_list "network.$br.ports" "$port"
		u_set network.wan2 interface
		u_set network.wan2.proto "$proto"
		u_set network.wan2.device "$port"
	else
		# mode=lan: give the port used by mode=port back to the LAN bridge
		br=$(brlan_section)
		if [ -n "$br" ]; then
			in_br=0
			for p in $(uci -q get "network.$br.ports"); do
				[ "$p" = "$port" ] && in_br=1
			done
			[ "$in_br" = 1 ] || u_add_list "network.$br.ports" "$port"
		fi
		u_set network.wan2dev device
		u_set network.wan2dev.name wan2dev
		u_set network.wan2dev.type macvlan
		u_set network.wan2dev.ifname br-lan
		mac=$(cget wan2.macaddr)
		[ -n "$mac" ] || mac=02:11:22:33:44:55
		u_set network.wan2dev.macaddr "$mac"
		u_set network.wan2 interface
		u_set network.wan2.proto "$proto"
		u_set network.wan2.device wan2dev
	fi

	if [ "$proto" = "static" ]; then
		[ -n "$ipaddr" ] && u_set network.wan2.ipaddr "$ipaddr"
		[ -n "$netmask" ] && u_set network.wan2.netmask "$netmask"
		[ -n "$gateway" ] && u_set network.wan2.gateway "$gateway"
	fi
	if [ "$proto" = "pppoe" ]; then
		u_set network.wan2.username "$(cget wan2.username)"
		u_set network.wan2.password "$(cget wan2.password)"
		[ -n "$(cget wan2.service)" ] && u_set network.wan2.service "$(cget wan2.service)"
	fi

	link_opts wan2 wan2 20
}

ensure_wwan() {
	if ! uci -q get network.wwan >/dev/null 2>&1; then
		u_set network.wwan interface
		u_set network.wwan.proto dhcp
	fi
	link_opts wwan wwan 30
}

ensure_usbwan() {
	local proto dev

	proto=$(cget usbwan.proto)
	[ -n "$proto" ] || proto=dhcp
	dev=$(cget usbwan.device)

	u_set network.usbwan interface
	u_set network.usbwan.proto "$proto"

	case "$proto" in
	dhcp)
		[ -n "$dev" ] || dev=$(usb_detect | awk 'NR==1 {print $1}')
		[ -n "$dev" ] && u_set network.usbwan.device "$dev"
		;;
	qmi|mbim)
		u_set network.usbwan.device "${dev:-/dev/cdc-wdm0}"
		u_set network.usbwan.apn "$(cget usbwan.apn)"
		[ -n "$(cget usbwan.username)" ] && {
			u_set network.usbwan.username "$(cget usbwan.username)"
			u_set network.usbwan.password "$(cget usbwan.password)"
		}
		u_set network.usbwan.pdptype "$(cget usbwan.pdptype)"
		;;
	esac

	link_opts usbwan usbwan 40
}

ensure_firewall() {
	local zone name iface

	zone=$(zone_wan) || return 0
	u_set "firewall.$zone.masq" 1
	u_set "firewall.$zone.mtu_fix" 1
	for name in $(ordered_uplinks); do
		[ "$(cget "$name.enabled")" = 1 ] || continue
		iface=$(cget "$name.interface")
		[ -n "$iface" ] || iface=$name
		u_del_list "firewall.$zone.network" "$iface"
		u_add_list "firewall.$zone.network" "$iface"
	done
}

mwan3_conf() {
	local name iface idx=0 ips ip reliability default_policy via r k v enabled tm
	local rel count timeout interval down up flush use_policy dn

	echo "config globals 'globals'"
	echo "	option mmx_mask '0x3F00'"
	echo

	for name in $(ordered_uplinks); do
		[ "$(cget "$name.enabled")" = 1 ] || continue
		idx=$((idx + 1))
		iface=$(cget "$name.interface")
		[ -n "$iface" ] || iface=$name
		ips=$(cget "$name.track_ip")
		[ -n "$ips" ] || ips=$(cget globals.track_ip)
		[ -n "$ips" ] || ips="223.5.5.5 119.29.29.29"
		ip=0
		for i in $ips; do ip=$((ip + 1)); done
		reliability=$ip
		[ "$reliability" -ge 1 ] || reliability=1
		rel=$(cget "$name.reliability")
		[ -n "$rel" ] || rel=$reliability
		[ "$rel" -ge 1 ] || rel=1
		tm=$(cget "$name.track_method")
		[ -n "$tm" ] || tm=ping
		count=$(cget "$name.count"); [ -n "$count" ] || count=1
		timeout=$(cget "$name.timeout"); [ -n "$timeout" ] || timeout=2
		interval=$(cget "$name.interval"); [ -n "$interval" ] || interval=5
		down=$(cget "$name.down"); [ -n "$down" ] || down=2
		up=$(cget "$name.up"); [ -n "$up" ] || up=2
		flush=$(cget "$name.flush_conntrack"); [ -n "$flush" ] || flush=1

		echo "config interface '$iface'"
		echo "	option enabled '1'"
		echo "	option family 'ipv4'"
		echo "	option track_method '$tm'"
		echo "	option reliability '$rel'"
		echo "	option count '$count'"
		echo "	option timeout '$timeout'"
		echo "	option interval '$interval'"
		echo "	option down '$down'"
		echo "	option up '$up'"
		if [ "$flush" = 1 ]; then
			echo "	list flush_conntrack 'disconnected'"
			echo "	list flush_conntrack 'ifdown'"
		fi
		for i in $ips; do
			echo "	list track_ip '$i'"
		done
		echo

		echo "config member 'wanctl_${name}_b'"
		echo "	option interface '$iface'"
		echo "	option metric '1'"
		echo "	option weight '$(cget "$name.weight")'"
		echo
		echo "config member 'wanctl_${name}_f'"
		echo "	option interface '$iface'"
		echo "	option metric '$idx'"
		echo "	option weight '1'"
		echo
		echo "config member 'wanctl_${name}_o'"
		echo "	option interface '$iface'"
		echo "	option metric '1'"
		echo "	option weight '1'"
		echo
	done

	echo "config policy 'wanctl_balanced'"
	for name in $(ordered_uplinks); do
		[ "$(cget "$name.enabled")" = 1 ] || continue
		echo "	list use_member 'wanctl_${name}_b'"
	done
	echo
	echo "config policy 'wanctl_failover'"
	for name in $(ordered_uplinks); do
		[ "$(cget "$name.enabled")" = 1 ] || continue
		echo "	list use_member 'wanctl_${name}_f'"
	done
	echo
	for name in $(ordered_uplinks); do
		[ "$(cget "$name.enabled")" = 1 ] || continue
		echo "config policy 'wanctl_o_$name'"
		echo "	list use_member 'wanctl_${name}_o'"
		echo
	done

	# enabled uplinks in priority order
	enabled_list=""
	for name in $(ordered_uplinks); do
		[ "$(cget "$name.enabled")" = 1 ] || continue
		enabled_list="$enabled_list $name"
	done

	# Per-uplink-first failover policies used by the smart destination sets:
	# wc_fo_<uplink> puts <uplink> first, then the other enabled uplinks in
	# the global order.  Dedicated members carry explicit metrics because the
	# shared _f members have global metrics that would tie.
	for via in $enabled_list; do
		via_iface=$(cget "$via.interface")
		[ -n "$via_iface" ] || via_iface=$via
		pos=1
		echo "config member 'wc_${via}_m1'"
		echo "	option interface '$via_iface'"
		echo "	option metric '1'"
		echo
		for other in $enabled_list; do
			[ "$other" = "$via" ] && continue
			pos=$((pos + 1))
			other_iface=$(cget "$other.interface")
			[ -n "$other_iface" ] || other_iface=$other
			echo "config member 'wc_${via}_m${pos}'"
			echo "	option interface '$other_iface'"
			echo "	option metric '$pos'"
			echo
		done
		echo "config policy 'wc_fo_$via'"
		p=1
		while [ "$p" -le "$pos" ]; do
			echo "	list use_member 'wc_${via}_m${p}'"
			p=$((p + 1))
		done
		echo
	done

	# Smart destination sets: the prober fills c526a_via_<uplink> with the
	# addresses that only work through that uplink.  mwan3 matches the set
	# as destination and uses the per-uplink-first policy.  Rules must come
	# before the catch-all default rule (mwan3 appends rules in config order).
	for via in $enabled_list; do
		echo "config rule 'wc_set_$via'"
		echo "	option ipset 'c526a_via_$via'"
		echo "	option family 'ipv4'"
		echo "	option proto 'all'"
		echo "	option use_policy 'wc_fo_$via'"
		echo
	done

	for r in $(uci -q show "$WANCTL" 2>/dev/null | sed -n "s/^$WANCTL\.\([^.=]*\)=route$/\1/p"); do
		via=$(cget "$r.via")
		[ -n "$via" ] || continue
		enabled=$(cget "$via.enabled")
		[ "$enabled" = 1 ] || continue
		echo "config rule 'wanctl_route_$r'"
		for k in src_ip dest_ip src_port dest_port proto family; do
			v=$(cget "$r.$k")
			[ -n "$v" ] && echo "	option $k '$v'"
		done
		echo "	option use_policy 'wanctl_o_$via'"
		echo "	option sticky '1'"
		[ "$(cget "$r.logging")" = 1 ] && echo "	option logging '1'"
		echo
	done

	default_policy=$(cget globals.default_policy)
	[ -n "$default_policy" ] || default_policy=failover
	case "$default_policy" in
	only_*)
		# pinning a single uplink: fall back to failover if it is disabled
		dn=${default_policy#only_}
		if [ "$(cget "$dn.enabled")" = 1 ]; then
			use_policy="wanctl_o_$dn"
		else
			default_policy=failover
			use_policy=wanctl_failover
		fi
		;;
	balanced|failover)
		use_policy="wanctl_$default_policy"
		;;
	*)
		use_policy=wanctl_failover
		;;
	esac
	echo "config rule 'wanctl_default'"
	echo "	option dest_ip '0.0.0.0/0'"
	echo "	option family 'ipv4'"
	echo "	option proto 'all'"
	echo "	option use_policy '$use_policy'"
	echo
}

build_mwan3() {
	if [ "$DRY" = 1 ]; then
		echo "# ---- /etc/config/mwan3 ----"
		mwan3_conf
		return 0
	fi
	mwan3_conf > /etc/config/mwan3.new && mv /etc/config/mwan3.new /etc/config/mwan3
}

# Smart destination sets: c526a_via_<uplink> holds addresses that only work
# through that uplink.  The prober (or "wanctl smart add") fills them; mwan3
# rules generated above match them as destination.
ensure_sets() {
	local name
	command -v ipset >/dev/null 2>&1 || return 0
	for name in $(uplinks); do
		if [ "$(cget "$name.enabled")" = 1 ]; then
			if [ "$DRY" = 1 ]; then
				echo "ipset -exist create c526a_via_$name hash:net"
			else
				ipset -exist create "c526a_via_$name" hash:net 2>/dev/null || true
			fi
		else
			if [ "$DRY" = 1 ]; then
				echo "ipset flush c526a_via_$name"
			else
				ipset flush "c526a_via_$name" 2>/dev/null || true
			fi
		fi
	done
}

apply() {
	[ "$DRY" = 1 ] || [ -f /etc/config/$WANCTL ] || {
		echo "wanctl: /etc/config/$WANCTL missing" >&2
		return 1
	}

	uci -q get "$WANCTL.globals" >/dev/null 2>&1 || {
		echo "wanctl: wanctl.globals missing" >&2
		return 1
	}

	if [ "$(cget wan2.enabled)" = 1 ]; then
		ensure_wan2
	elif [ "$(cget wan2.mode)" = "port" ]; then
		br=$(brlan_section)
		if [ -n "$br" ]; then
			u_del_list "network.$br.ports" "$(cget wan2.port)"
			u_add_list "network.$br.ports" "$(cget wan2.port)"
		fi
		u_del network.wan2
	fi
	[ "$(cget wwan.enabled)" = 1 ] && ensure_wwan
	[ "$(cget usbwan.enabled)" = 1 ] && ensure_usbwan

	ensure_firewall
	build_mwan3
	ensure_sets

	u_commit network
	u_commit firewall
	u_commit "$WANCTL"

	[ "$DRY" = 1 ] && return 0

	ubus call network reload >/dev/null 2>&1 || /etc/init.d/network reload >/dev/null 2>&1
	sleep 1
	[ -x /etc/init.d/mwan3 ] && /etc/init.d/mwan3 restart >/dev/null 2>&1
	[ -x /etc/init.d/firewall ] && /etc/init.d/firewall reload >/dev/null 2>&1
	log "applied"
}

status() {
	local name iface up addr gw

	for name in $(uplinks); do
		iface=$(cget "$name.interface")
		[ -n "$iface" ] || iface=$name
		up=$(ubus call network.interface."$iface" status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)
		addr=$(ubus call network.interface."$iface" status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
		gw=$(ubus call network.interface."$iface" status 2>/dev/null | jsonfilter -e '@.route[0].nexthop' 2>/dev/null)
		printf '%-8s %-8s up=%-5s addr=%-15s gw=%s\n' \
			"$name" "$iface" "${up:-?}" "${addr:--}" "${gw:--}"
	done
	echo
	if command -v ipset >/dev/null 2>&1; then
		for name in $(uplinks); do
			n=$(ipset list "c526a_via_$name" 2>/dev/null | sed -n 's/^Number of entries: //p')
			[ -n "$n" ] && printf 'smart    %-8s %s entries\n' "$name" "$n"
		done
	fi
	mwan3 status 2>/dev/null | sed -n '1,40p'
}

usb_detect() {
	local d n drv
	for d in /sys/class/net/*; do
		n=${d##*/}
		[ -e "$d/device" ] || continue
		drv=$(basename "$(readlink -f "$d/device/driver" 2>/dev/null)" 2>/dev/null)
		case "$drv" in
		rndis_host|cdc_ether|cdc_ncm|qmi_wan|qmi_wwan|cdc_mbim|ipheth)
			echo "$n $drv"
			;;
		esac
	done
}

check() {
	local name iface mode port proto br lanip bad=0

	command -v mwan3 >/dev/null 2>&1 || { echo "WARN: mwan3 is not installed"; bad=1; }

	for name in $(uplinks); do
		[ "$(cget "$name.enabled")" = 1 ] || continue
		iface=$(cget "$name.interface")
		[ -n "$iface" ] || iface=$name
		uci -q get "network.$iface" >/dev/null 2>&1 || {
			echo "WARN: $name: network.$iface does not exist"
			bad=1
		}

		if [ "$name" = wan2 ]; then
			mode=$(cget wan2.mode)
			proto=$(cget wan2.proto)
			if [ "$mode" = port ]; then
				port=$(cget wan2.port)
				[ -n "$port" ] || { echo "WARN: wan2.port is empty"; bad=1; }
				[ -e "/sys/class/net/$port" ] || {
					echo "WARN: $port is not present in the kernel"
					bad=1
				}
				br=$(brlan_section)
				if [ -n "$br" ] && uci -q get "network.$br.ports" 2>/dev/null | grep -qw "$port"; then
					echo "WARN: $port is still a member of br-lan (run 'wanctl apply')"
					bad=1
				fi
			fi
			if [ "$proto" = static ]; then
				for k in ipaddr netmask gateway; do
					[ -n "$(cget "wan2.$k")" ] || {
						echo "WARN: wan2.$k is empty"
						bad=1
					}
				done
				lanip=$(uci -q get network.lan.ipaddr)
				[ -n "$lanip" ] && [ "$lanip" = "$(cget wan2.ipaddr)" ] && {
					echo "WARN: wan2.ipaddr equals the LAN address"
					bad=1
				}
			fi
		fi

		if [ "$name" = usbwan ]; then
			proto=$(cget usbwan.proto)
			case "$proto" in
			qmi|mbim)
				[ -n "$(cget usbwan.device)" ] || {
					echo "WARN: usbwan.device is empty for $proto"
					bad=1
				}
				[ -n "$(cget usbwan.apn)" ] || echo "WARN: usbwan.apn is empty"
				;;
			esac
		fi
	done

	if command -v ipset >/dev/null 2>&1; then
		for name in $(uplinks); do
			[ "$(cget "$name.enabled")" = 1 ] || continue
			ipset list "c526a_via_$name" >/dev/null 2>&1 || {
				echo "WARN: ipset c526a_via_$name missing (run 'wanctl apply')"
				bad=1
			}
		done
	fi

	[ "$bad" = 0 ] && echo "check: OK"
	return "$bad"
}

usage() {
	cat <<EOF
usage: wanctl <command>

  apply                     write network/firewall/mwan3 config and reload
  check                     validate the current wanctl configuration
  status                    show uplink and mwan3 status
  uplink list|enable|disable <name>
  wan2 port <lanX> dhcp|static [ip mask gateway]
  wan2 lan
  wan2 off
  set <section> <option> <value>
  default failover|balanced|only_<uplink>
                            default policy; only_<uplink> pins one uplink
  order <uplink ...>       failover priority, e.g. 'wan wan2 wwan usbwan'
  route add <name> via=<uplink> [src_ip=..] [dest_ip=..] [src_port=..] [dest_port=..] [proto=..]
  route del <name>
  route list
  smart show                show the per-uplink destination sets
  smart add <ip|cidr> <uplink>
                            force this destination through <uplink> first
  smart del <ip|cidr>       remove a destination from all sets
  smart flush [uplink]      empty one or all destination sets
  usb-detect                print USB network interfaces seen by the kernel

Examples:
  wanctl set wan2 enabled 1
  wanctl set wan2 mode lan
  wanctl set wan2 gateway 192.168.1.1
  wanctl set usbwan proto qmi
  wanctl default balanced
  wanctl route add nas via=wan2 dest_ip=192.168.1.0/24
EOF
}

[ "$1" = "--dry-run" ] && { DRY=1; shift; }

cmd=$1
[ $# -gt 0 ] && shift

case "$cmd" in
apply|"")
	apply
	;;
status)
	status
	;;
uplink)
	act=$1; name=$2
	case "$act" in
	list) uplinks ;;
	enable|disable)
		[ -n "$name" ] || { usage; exit 1; }
		uci set "$WANCTL.$name.enabled=$([ "$act" = enable ] && echo 1 || echo 0)"
		uci commit "$WANCTL"
		apply
		;;
	*) usage; exit 1 ;;
	esac
	;;
set)
	sec=$1; opt=$2; shift 2
	[ -n "$sec" ] && [ -n "$opt" ] || { usage; exit 1; }
	uci set "$WANCTL.$sec.$opt=$*"
	uci commit "$WANCTL"
	apply
	;;
check)
	check
	;;
wan2)
	act=$1; shift
	case "$act" in
	port)
		port=$1; proto=$2; shift 2
		[ -n "$port" ] && [ -n "$proto" ] || { usage; exit 1; }
		uci set "$WANCTL.wan2.enabled=1"
		uci set "$WANCTL.wan2.mode=port"
		uci set "$WANCTL.wan2.port=$port"
		uci set "$WANCTL.wan2.proto=$proto"
		if [ "$proto" = static ]; then
			[ -n "$1" ] && uci set "$WANCTL.wan2.ipaddr=$1"
			[ -n "$2" ] && uci set "$WANCTL.wan2.netmask=$2"
			[ -n "$3" ] && uci set "$WANCTL.wan2.gateway=$3"
		fi
		uci commit "$WANCTL"
		apply
		;;
	lan)
		uci set "$WANCTL.wan2.enabled=1"
		uci set "$WANCTL.wan2.mode=lan"
		uci commit "$WANCTL"
		apply
		;;
	off)
		uci set "$WANCTL.wan2.enabled=0"
		uci commit "$WANCTL"
		apply
		;;
	*) usage; exit 1 ;;
	esac
	;;
default)
	p=$1
	case "$p" in
	failover|balanced) ;;
	only_*)
		n=${p#only_}
		[ "$(cget "$n")" = uplink ] || { echo "wanctl: unknown uplink '$n'" >&2; exit 1; }
		;;
	*) usage; exit 1 ;;
	esac
	uci set "$WANCTL.globals.default_policy=$p"
	uci commit "$WANCTL"
	apply
	;;
order)
	[ $# -gt 0 ] || { usage; exit 1; }
	uci set "$WANCTL.globals.order=$*"
	uci commit "$WANCTL"
	apply
	;;
route)
	act=$1; name=$2; shift 2
	case "$act" in
	add)
		[ -n "$name" ] || { usage; exit 1; }
		uci set "$WANCTL.$name=route"
		for kv in "$@"; do
			uci set "$WANCTL.$name.${kv%%=*}=${kv#*=}"
		done
		uci commit "$WANCTL"
		apply
		;;
	del)
		uci -q delete "$WANCTL.$name"
		uci commit "$WANCTL"
		apply
		;;
	list)
		uci -q show "$WANCTL" | grep '=route' || true
		;;
	*) usage; exit 1 ;;
	esac
	;;
smart)
	act=$1; shift
	case "$act" in
	show)
		for name in $(uplinks); do
			echo "== $name (c526a_via_$name)"
			ipset list "c526a_via_$name" 2>/dev/null | sed -n '/^Members:/,$p' | tail -n +2
		done
		;;
	add)
		ip=$1; via=$2
		[ -n "$ip" ] && [ -n "$via" ] || { usage; exit 1; }
		[ "$(cget "$via")" = uplink ] || { echo "wanctl: unknown uplink '$via'" >&2; exit 1; }
		ensure_sets >/dev/null 2>&1
		ipset -exist add "c526a_via_$via" "$ip"
		;;
	del)
		ip=$1
		[ -n "$ip" ] || { usage; exit 1; }
		for name in $(uplinks); do
			ipset -exist del "c526a_via_$name" "$ip" 2>/dev/null || true
		done
		;;
	flush)
		via=$1
		if [ -n "$via" ]; then
			ipset flush "c526a_via_$via" 2>/dev/null || true
		else
			for name in $(uplinks); do
				ipset flush "c526a_via_$name" 2>/dev/null || true
			done
		fi
		;;
	*) usage; exit 1 ;;
	esac
	;;
usb-detect)
	usb_detect
	;;
*)
	usage
	exit 1
	;;
esac

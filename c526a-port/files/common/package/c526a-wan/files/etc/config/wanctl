config globals 'globals'
	option enabled '1'
	# failover = strict priority (order), balanced = weighted load sharing
	option default_policy 'failover'
	# first entry is preferred; mwan3 falls through on tracking failure
	# and switches back automatically when it recovers
	option order 'wan wan2 wwan usbwan'
	option track_ip '223.5.5.5 119.29.29.29'
	# token for the /wan/ web UI; generated on first boot
	option api_token ''
	# IPv6 mode: relay = LAN gets the uplink prefix (public addresses),
	# nat66 = ULA + masquerade, off = no LAN IPv6
	option ipv6_mode 'relay'
	# auto, or an uplink name to prefer when it is healthy
	option ipv6_uplink 'auto'
	# maintained by wanctl, shown in the web UI
	option ipv6_active ''

config uplink 'wan'
	option enabled '1'
	option interface 'wan'
	option weight '1'
	option track_method 'ping'
	option track_ip '223.5.5.5 119.29.29.29'
	# one of the two IPs is enough to consider the uplink alive
	option reliability '1'
	option count '1'
	option timeout '2'
	option interval '5'
	# 2 failed checks -> down (~10s), 2 good checks -> up
	option down '2'
	option up '2'
	# drop existing flows when the active uplink changes
	option flush_conntrack '1'

config uplink 'wan2'
	option enabled '1'
	option interface 'wan2'
	# lan  = macvlan on br-lan, use the upstream gateway on the LAN segment
	# port = take a LAN port out of br-lan and use it as a second WAN
	option mode 'port'
	option port 'lan3'
	# dhcp | static | pppoe
	option proto 'dhcp'
	option ipaddr '192.168.2.2'
	option netmask '255.255.255.0'
	option gateway '192.168.2.1'
	option username ''
	option password ''
	option service ''
	option macaddr '02:11:22:33:44:55'
	option metric '20'
	option peerdns '0'
	option dns '223.5.5.5 119.29.29.29'
	option track_method 'ping'
	option track_ip '223.5.5.5 119.29.29.29'
	option reliability '1'
	option count '1'
	option timeout '2'
	option interval '5'
	option down '2'
	option up '2'
	option flush_conntrack '1'
	option weight '1'

config uplink 'wwan'
	option enabled '0'
	option interface 'wwan'
	option metric '30'
	option peerdns '0'
	option track_method 'ping'
	option track_ip '223.5.5.5 119.29.29.29'
	option reliability '1'
	option count '1'
	option timeout '2'
	option interval '5'
	option down '2'
	option up '2'
	option flush_conntrack '1'
	option weight '1'

config uplink 'usbwan'
	option enabled '0'
	option interface 'usbwan'
	# dhcp (RNDIS/ECM/NCM) | qmi | mbim
	option proto 'dhcp'
	option device ''
	option apn ''
	option username ''
	option password ''
	option pdptype 'ipv4'
	option metric '40'
	option peerdns '0'
	option track_method 'ping'
	option track_ip '223.5.5.5 119.29.29.29'
	option reliability '1'
	option count '1'
	option timeout '2'
	option interval '5'
	option down '2'
	option up '2'
	option flush_conntrack '1'
	option weight '1'

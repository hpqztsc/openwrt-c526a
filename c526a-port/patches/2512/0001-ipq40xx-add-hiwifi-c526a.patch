diff --git a/target/linux/ipq40xx/image/generic.mk b/target/linux/ipq40xx/image/generic.mk
index 4e155a3..777c3da 100644
--- a/target/linux/ipq40xx/image/generic.mk
+++ b/target/linux/ipq40xx/image/generic.mk
@@ -1426,3 +1426,30 @@ define Device/zyxel_wre6606
 endef
 # Missing DSA Setup
 #TARGET_DEVICES += zyxel_wre6606
+
+define Device/hiwifi_c526a_common
+	$(call Device/FitzImage)
+	$(call Device/UbiFit)
+	DEVICE_VENDOR := HiWiFi
+	DEVICE_MODEL := C526A
+	SOC := qcom-ipq4019
+	BLOCKSIZE := 128k
+	PAGESIZE := 2048
+	DEVICE_PACKAGES := ipq-wifi-hiwifi-c526a kmod-mt7615e kmod-mt7615-firmware -ath10k-board-qca4019
+endef
+
+define Device/hiwifi_c526a
+	$(call Device/hiwifi_c526a_common)
+	SUPPORTED_DEVICES += hiwifi,c526a
+endef
+TARGET_DEVICES += hiwifi_c526a
+
+define Device/hiwifi_c526a-128m
+	$(call Device/hiwifi_c526a_common)
+	DEVICE_VARIANT := 128M NAND
+	DEVICE_DTS := qcom-ipq4019-c526a-128m
+	# the 5.4 firmware reports "hiwifi,c526a" even on the 128M layout,
+	# so accept both names for the first upgrade
+	SUPPORTED_DEVICES += hiwifi,c526a hiwifi,c526a-128m
+endef
+TARGET_DEVICES += hiwifi_c526a-128m

 	cellc,rtl30vw)
 		caldata_extract "0:ART" 0x5000 0x2f20
 		;;
+	hiwifi,c526a|\
+	hiwifi,c526a-128m)
+		caldata_extract "ART" 0x5000 0x2f20
+		ath10k_patch_mac $(macaddr_add $(mtd_get_mac_ascii bdinfo "Vfac_mac ") 3)
